          "x": 528,
          "y": 680,
          "width": 440,
          "height": 80
        }
      ]
    },
    {
      "id": "measured",
      "title": "测量已记录",
      "kind": "feedback",
      "body": "本次测量完成，可以进入经线测距。若改变日期或位置，旧测量失效。",
