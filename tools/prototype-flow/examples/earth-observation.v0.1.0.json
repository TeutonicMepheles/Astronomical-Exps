{
  "schema_version": 1,
  "id": "earth-observation-starter",
  "version": "0.1.0",
  "parent_digest": null,
  "title": "地球周长 · 观测到计算灰度流程",
  "target": "figma-native-grayscale",
  "change_summary": "首版流程工具样例，非正式实验验收版本。",
  "scope": "展示选点、手动对齐、测影、经线点选测距、返回和记录失效。只做有限状态灰度交互，不模拟科学计算、自由三维拖动、连续输入、动画或全量教学。",
  "canvas": {
    "width": 1600,
    "height": 900
  },
  "entry": "choose",
  "requirements": [
    {
      "id": "whiteboard",
      "kind": "project_constraint",
      "text": "16:9，以点按和拖拽为主，不依赖悬停或滚动。",
      "source": "AGENTS.md; Visual-Spec/VISUAL_SPEC.md#展示与交互约定"
    },
    {
      "id": "manual-noon",
      "kind": "confirmed_requirement",
      "text": "点选后保留当前自转，由学生自行对齐正午。",
      "source": "experiments/earth-circumference/REQUIREMENTS.md#2026-11-09 用户确认的选点到观测展示流程"
    },
    {
      "id": "measure-order",
      "kind": "confirmed_requirement",
      "text": "观测点测量完成即可继续，第三阶段依次点观测点和直射点。",
      "source": "experiments/earth-circumference/REQUIREMENTS.md"
    },
    {
      "id": "simple-layout",
      "kind": "candidate",
      "text": "固定场景区和下方动作区，仅是首版编译器布局，等待用户评价。",
      "source": "tools/prototype-flow/README.md"
    }
  ],
  "uncertainties": [
    "科学参数、单位、误差与特殊角度处理参照 Function-Spec/OPEN_DECISIONS.md，不能从本样例推断已确认。",
    "ON_DRAG 只表示离散状态跳转，不是真实进度拖动。",
    "场景均为文字灰度占位，需在 Figma 视觉审查中决定下一版细节。"
  ],
  "states": [
    {
