  "scenarios": [
    {
      "id": "complete-flow",
      "category": "happy",
      "start": "choose",
      "steps": [
        "select-observer",
        "align-noon",
        "open-observation",
        "measure-shadow",
        "continue-distance",
        "pick-distance-start",
        "pick-distance-end",
        "calculate"
      ],
      "end": "result",
      "expected": "手动对齐后才进入观测；完成两点测距后才可展示计算过程。"
    },
    {
      "id": "cancel-and-return",
      "category": "cancel",
      "start": "aligned",
      "steps": [
        "open-observation",
        "close-observation",
        "open-observation",
        "measure-shadow",
        "continue-distance",
        "pick-distance-start",
        "cancel-distance"
      ],
      "end": "distance",
      "expected": "关闭面板返回已对齐状态；取消测距回到起点选择，不错误标记为已完成。"
    },
    {
      "id": "repeat-measurement",
      "category": "repeat",
      "start": "ready",
      "steps": [
        "remeasure-distance",
        "pick-distance-start",
        "pick-distance-end",
        "calculate",
        "revisit-distance",
        "pick-distance-start",
        "pick-distance-end"
      ],
      "end": "ready",
      "expected": "反复返回与重测仍可完成，所有控件存在可用跳转。"
    },
    {
      "id": "invalidate-and-recover",
      "category": "error",
      "start": "ready",
      "steps": [
        "invalidate-record",
        "recover-observation",
        "align-noon",
        "open-observation",
        "measure-shadow",
        "continue-distance",
        "pick-distance-start",
        "pick-distance-end"
      ],
      "end": "ready",
      "expected": "改变条件使旧记录不可用，经重新观测和测距才能回到可计算状态。"
    }
  ]
}
