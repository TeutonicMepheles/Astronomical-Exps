        {
          "id": "recover-observation",
          "label": "返回对齐并重新观测",
          "target": "selected",
          "trigger": "ON_CLICK",
          "role": "recovery",
          "x": 48,
          "y": 680,
          "width": 440,
          "height": 80
        }
      ]
